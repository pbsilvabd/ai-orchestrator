{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Declarative persisted task record. Accepts optional scheduler dispatch receipts, process outcomes, nested B13 artifacts and legacy flat artifact fields. Cross-field consistency and byte budgets are enforced by runtime code.",
  "meta": {
    "title": "task-record",
    "source": "src/tasks.mjs validateTask and validateArtifact"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "clientId",
    "idempotencyKey",
    "payloadHash",
    "request",
    "status",
    "createdAt",
    "acceptedAt",
    "startedAt",
    "finishedAt",
    "attempts",
    "cancel",
    "block",
    "progress"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "taskId": {
      "description": "Opaque UUIDv4 identifier; the store only enforces the identifier pattern.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "payloadHash": {
      "description": "SHA-256 hex digest of the canonical payload.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request": {
      "description": "The validated submit request without clientSessionId; see task-submit-request.schema.json.",
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "blocked", "cancelled"]
    },
    "createdAt": {
      "description": "Epoch milliseconds. Non-negativity is not expressible without a minimum keyword and stays imperative.",
      "type": "integer"
    },
    "acceptedAt": {
      "type": "integer"
    },
    "startedAt": {
      "type": ["integer", "null"]
    },
    "finishedAt": {
      "type": ["integer", "null"]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attemptId", "model", "startedAt"],
        "properties": {
          "attemptId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "startedAt": {
            "type": "integer"
          },
          "finishedAt": {
            "type": ["integer", "null"]
          },
          "outcome": {
            "description": "Recorded by the executor adapter; the store does not validate it today.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "exitCode": { "type": ["integer", "null"] },
          "spawnErrorCode": { "type": ["string", "null"] },
          "workspace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "baseCommit", "branch", "workspacePath", "receiptPath"],
            "properties": {
              "taskId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
              "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
              "branch": { "type": "string", "minLength": 1 },
              "workspacePath": { "type": "string", "minLength": 1 },
              "receiptPath": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedAt", "executionStopped", "effectsReverted"],
      "properties": {
        "requestedAt": {
          "type": ["integer", "null"]
        },
        "executionStopped": {
          "description": "True only when the worker confirmed no work is running; 'unknown' after an abort, crash or restart.",
          "type": ["boolean", "string", "null"],
          "enum": [null, true, "unknown"]
        },
        "effectsReverted": {
          "description": "Cancellation is a request, never proof that effects were undone.",
          "type": "boolean",
          "enum": [false]
        }
      }
    },
    "block": {
      "description": "Null unless the task needs maintainer reconciliation.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "requiresReconciliation"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requiresReconciliation": {
          "type": "boolean",
          "enum": [true]
        }
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "event"],
        "properties": {
          "at": {
            "type": "integer"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit", "branch", "headCommit", "diff", "diffTruncated", "changedFiles",
        "testRuns", "logsTruncated", "limitations", "cost", "evidenceLevel"
      ],
      "properties": {
        "baseCommit": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "headCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
        "diff": { "type": ["string", "null"] },
        "diffTruncated": { "type": "boolean" },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "testRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exitCode", "durationMs", "summary", "outputTail", "outputTruncated"],
            "properties": {
              "command": { "type": "string" },
              "exitCode": { "type": "integer" },
              "durationMs": { "type": "integer" },
              "summary": { "type": "string" },
              "outputTail": { "type": "string" },
              "outputTruncated": { "type": "boolean" }
            }
          }
        },
        "workerLog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outputTail", "outputTruncated"],
          "properties": {
            "outputTail": { "type": "string" },
            "outputTruncated": { "type": "boolean" }
          }
        },
        "logsTruncated": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "amount", "currency", "note"],
          "properties": {
            "known": { "type": "boolean", "enum": [false] },
            "amount": { "type": "null" },
            "currency": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "evidenceLevel": {
          "type": "string",
          "enum": ["unit", "local-http", "opencode-integration", "use-on-project"]
        }
      }
    },
    "testRuns": {
      "description": "Test runs recorded by the executor through updateTask. command is optional because the runtime tolerates a run without one (src/service.mjs:192-199) and reports the missing command as a limitation.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exitCode"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "outputTail": {
            "type": "string"
          },
          "outputTruncated": {
            "type": "boolean"
          }
        }
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseCommit": {
      "type": ["string", "null"]
    },
    "branch": {
      "description": "Optional branch recorded by an executor; src/service.mjs:207 reads it and no runtime writer sets it today.",
      "type": ["string", "null"]
    },
    "headCommit": {
      "type": ["string", "null"]
    },
    "diff": {
      "type": ["string", "null"]
    },
    "diffTruncated": {
      "type": "boolean"
    }
  }
}
